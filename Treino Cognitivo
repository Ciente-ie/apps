<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ciente IE — Treinamento Cognitivo</title>

  <!-- Firebase -->
  <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-firestore-compat.js"></script>

  <script>
    const firebaseConfigIntegrado = {
      apiKey: "AIzaSyDsoutLk5gmxq5zlu548HWFrox37u1zrxk",
      authDomain: "appintegrado-ciente.firebaseapp.com",
      projectId: "appintegrado-ciente",
      storageBucket: "appintegrado-ciente.appspot.com",
      messagingSenderId: "1016862716358",
      appId: "1:1016862716358:web:28ff5b4566e6f68dd36a3c"
    };

    const appIntegrado = firebase.initializeApp(firebaseConfigIntegrado, "appIntegrado");
    const db = appIntegrado.firestore();

    const state = { athlete: null, hrv: null, hooper: null, exercicios: [] };

    document.addEventListener("DOMContentLoaded", carregarListaAtletas);

    async function carregarListaAtletas() {
      const sel = document.getElementById("athleteSelect");
      sel.innerHTML = "";
      const snap = await db.collection("prontidao").get();
      const nomes = new Set();
      snap.forEach(doc => {
        const d = doc.data();
        if (d.nome_atleta) nomes.add(d.nome_atleta.trim());
      });
      Array.from(nomes).sort().forEach(n => {
        const opt = document.createElement("option");
        opt.value = n;
        opt.textContent = n;
        sel.appendChild(opt);
      });
    }

    async function buscarDadosProntidao(nomeAtleta) {
      const snap = await db.collection("prontidao").get();
      const normalize = s => s ? s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim().toLowerCase() : "";
      const registros = [];
      snap.forEach(doc => {
        const d = doc.data();
        const nomeBanco = d.nome_atleta || "";
        if (normalize(nomeBanco) === normalize(nomeAtleta)) registros.push(d);
      });
      if (registros.length === 0) return null;
      registros.sort((a,b)=> new Date(b.data) - new Date(a.data));
      const d = registros[0];
      return { hrv: d.vfc_rmssd || d.vfc, hooper: d.hooper_score || d.hooper };
    }

    async function confirmAthlete() {
      const nome = document.getElementById("athleteSelect").value || document.getElementById("newAthlete").value;
      if (!nome) return alert("Selecione ou adicione um atleta.");
      state.athlete = nome.trim();
      const dados = await buscarDadosProntidao(state.athlete);
      if (!dados || dados.hrv == null || dados.hooper == null) return showStep("stepErro");
      state.hrv = dados.hrv; state.hooper = dados.hooper;
      if (dados.hrv < 70 || dados.hooper > 16) showStep("stepMindfulness");
      else showStep("stepCognitive");
    }

    function showStep(id) {
      document.querySelectorAll(".container > div").forEach(d => d.classList.add("hidden"));
      document.getElementById(id).classList.remove("hidden");
    }
  </script>

  <style>
    body { margin:0; font-family:Arial,sans-serif; background:linear-gradient(to bottom,#0b1e3d,#142b57); color:white; }
    .container { max-width:740px; margin:24px auto; background:white; color:#111827; padding:24px; border-radius:16px; box-shadow:0 8px 20px rgba(0,0,0,0.25); }
    h1,h2 { text-align:center; color:#102853; }
    .hidden { display:none; }
    input,select,button { width:100%; padding:10px; margin:6px 0; border-radius:10px; border:1px solid #ccc; font-size:15px; }
    button { background-color:#102853; color:white; border:none; cursor:pointer; }
    button:hover { background-color:#1e3a8a; }
    .card { background:#f8fafc; border-radius:12px; padding:16px; margin-top:16px; box-shadow:0 4px 10px rgba(0,0,0,0.05); }
    small { color:#444; }
  </style>
</head>
<body>
  <div class="container">
    <h1>🧠 Treinamento Cognitivo</h1>

    <!-- Seleção de atleta -->
    <div id="step1">
      <h2>👤 Escolha o atleta</h2>
      <select id="athleteSelect"></select>
      <input id="newAthlete" placeholder="Novo atleta (Nome)">
      <button onclick="confirmAthlete()">Confirmar</button>
    </div>

    <div id="stepErro" class="hidden">
      <h2>⚠️ Sem dados suficientes</h2>
      <button onclick="showStep('step1')">🔙 Voltar</button>
    </div>

<!-- Sessão de Mindfulness -->
<div id="stepMindfulness" class="hidden">
  <h2>🧘‍♂️ Sessão de Respiração — Coerência Cardíaca</h2>
  <p style="font-size:16px;line-height:1.6;">
    Seu corpo precisa de um momento para restabelecer o equilíbrio fisiológico antes de um treino cognitivo.
  </p>

  <div id="breathCircle"
       style="width:150px;height:150px;margin:24px auto;border-radius:50%;background:#1e3a8a;
              transition:transform 4s ease-in-out, background 4s ease-in-out;"></div>

  <h3 id="breathText" style="text-align:center;font-size:22px;margin-top:10px;color:#102853;">Inspire</h3>
  <div id="breathTimer" style="text-align:center;margin-top:8px;font-size:18px;color:#555;"></div>
  <div id="totalTimer" style="text-align:center;margin-top:6px;font-size:15px;color:#777;">Tempo restante: 03:00</div>

  <div style="display:flex;justify-content:space-between;margin-top:16px;">
    <button style="width:48%;" onclick="showStep('step1')">⬅️ Voltar</button>
    <button style="width:48%;" id="btnStartMindfulness" onclick="startMindfulness()">▶️ Iniciar Sessão</button>
  </div>
  <button id="btnStopMindfulness" onclick="stopMindfulness()" disabled style="margin-top:10px;width:100%;">⏹️ Parar</button>
  <button id="btnAvancarMindfulness" onclick="showStep('stepCognitive')" class="hidden" style="margin-top:10px;width:100%;">➡️ Avançar</button>
</div>

<script>
  let breathInterval=null,totalInterval=null,phaseIndex=0,secondsLeft=0,totalSeconds=180;
  const phases=[{label:"Inspire",duration:4},{label:"Segure",duration:2},{label:"Expire",duration:6}];
  function updateBreathUI(){
    const phase=phases[phaseIndex];
    breathText.innerText=phase.label;
    secondsLeft=phase.duration;
    breathTimer.innerText=`${secondsLeft}s`;
    if(phase.label==="Inspire"){breathCircle.style.transform="scale(1.4)";breathCircle.style.background="#2563eb";}
    else if(phase.label==="Segure"){breathCircle.style.transform="scale(1.4)";breathCircle.style.background="#1d4ed8";}
    else{breathCircle.style.transform="scale(1)";breathCircle.style.background="#1e3a8a";}
    clearInterval(breathInterval);
    breathInterval=setInterval(()=>{secondsLeft--;breathTimer.innerText=`${secondsLeft}s`;
      if(secondsLeft<=0){clearInterval(breathInterval);phaseIndex=(phaseIndex+1)%phases.length;updateBreathUI();}},1000);
  }
  function startMindfulness(){
    phaseIndex=0;totalSeconds=180;
    document.getElementById("btnStartMindfulness").disabled=true;
    document.getElementById("btnStopMindfulness").disabled=false;
    document.getElementById("btnAvancarMindfulness").classList.add("hidden");
    updateBreathUI();
    clearInterval(totalInterval);
    updateTotalTimer();
    totalInterval=setInterval(()=>{
      totalSeconds--;updateTotalTimer();
      if(totalSeconds<=0){stopMindfulness();finalizarMindfulness();}},1000);
  }
  function updateTotalTimer(){
    const min=Math.floor(totalSeconds/60),sec=totalSeconds%60;
    totalTimer.innerText=`Tempo restante: ${String(min).padStart(2,"0")}:${String(sec).padStart(2,"0")}`;
  }
  function stopMindfulness(){
    clearInterval(breathInterval);clearInterval(totalInterval);
    breathText.innerText="Sessão pausada";breathTimer.innerText="";
    document.getElementById("btnStartMindfulness").disabled=false;
    document.getElementById("btnStopMindfulness").disabled=true;
  }
  function finalizarMindfulness(){
    breathText.innerText="✅ Sessão concluída";
    totalTimer.innerText="3 minutos completos!";
    document.getElementById("btnAvancarMindfulness").classList.remove("hidden");
    document.getElementById("btnStartMindfulness").disabled=false;
    document.getElementById("btnStopMindfulness").disabled=true;
  }
</script>

<!-- 🔹 Treino Cognitivo -->
<div id="stepCognitive" class="hidden">
  <h2>⚡ Treino Cognitivo</h2>

  <!-- Treino Cognitivo Geral -->
  <div class="card">
    <h3>Treino Cognitivo Geral</h3>
    <select id="exGeral" onchange="mostrarBotaoJogo()">
      <option value="">Selecione</option>
      <option>🎯 Jogo de Atenção</option>
      <option>🎯 Jogo de Foco</option>
      <option>🧩 Jogo de Memória</option>
      <option>👁️‍🗨️ Jogo de Rastreamento Visual</option>
      <optgroup label="Jogos Cognitivos">
        <option>Inversão</option>
        <option>Torre de Hanoi</option>
        <option>Cubo</option>
        <option>T</option>
        <option>Tangram</option>
        <option>App Two Cars</option>
      </optgroup>
    </select>

    <div id="botaoAbrirJogo" style="display:none; text-align:center;">
      <button onclick="abrirJogoSelecionado()">🕹️ Abrir Jogo</button>
    </div>

    <input id="tempoGeral" type="number" min="1" placeholder="Tempo (min)">
    <p>Como você percebeu seu desempenho no exercício?</p>
    <select id="notaGeral">
      <option value="">Selecione</option>
      <option>0</option><option>1</option><option>2</option><option>3</option><option>4</option>
      <option>5</option><option>6</option><option>7</option><option>8</option><option>9</option><option>10</option>
    </select>
    <small>0 = Péssimo  10 = Excelente</small>
    <button onclick="adicionarExercicio('geral')">Adicionar</button>
  </div>

  <!-- Treino Cognitivo Específico -->
  <div class="card">
    <h3>Treino Cognitivo Específico</h3>
    <select id="exEspecifico" onchange="mostrarLegendaEspecifico()">
      <option value="">Selecione</option>
      <option>Tempo de Reação</option>
      <option>Tempo de Reação / Força</option>
      <option>Tempo de Reação / Agilidade</option>
    </select>
    <div id="legendaEspecifico" style="font-size:14px;color:#444;margin-top:4px;"></div>

    <input id="tempoEspecifico" type="number" min="1" placeholder="Tempo (min)">
    <p>Como você percebeu seu desempenho no exercício?</p>
    <select id="notaEspecifico">
      <option value="">Selecione</option>
      <option>0</option><option>1</option><option>2</option><option>3</option><option>4</option>
      <option>5</option><option>6</option><option>7</option><option>8</option><option>9</option><option>10</option>
    </select>
    <small>0 = Péssimo  10 = Excelente</small>
    <button onclick="adicionarExercicio('especifico')">Adicionar</button>
  </div>

  <div style="display:flex;justify-content:space-between;margin-top:20px;">
    <button style="width:48%;" onclick="showStep('stepMindfulness')">⬅️ Voltar</button>
    <button style="width:48%;" onclick="avancarVisualizacao()">➡️ Avançar</button>
  </div>
</div>
<!-- ========================================================= -->
<!-- 🔹 VISUALIZAÇÃO GUIADA -->
<!-- ========================================================= -->
<div id="stepVisualizacao" class="hidden">
  <h2>🎯 Visualização Guiada</h2>
  <p id="visualText" style="font-size:17px;line-height:1.5;">
    Feche os olhos e visualize o movimento que você deseja executar com excelência.
  </p>
  <button onclick="changeVisual()">🔄 Alterar Texto</button>

  <p>Duração (min):</p>
  <select id="tempoVisualizacao">
    <option>1</option><option>2</option><option>3</option><option>4</option><option>5</option>
  </select>

  <div id="visualTimer" style="font-size:26px;text-align:center;margin:14px 0;color:#102853;"></div>
  <button onclick="startVisualizacao()">▶️ Iniciar</button>
  <button onclick="stopVisualizacao()">⏹️ Parar</button>

  <div style="display:flex;justify-content:space-between;margin-top:20px;">
    <button style="width:48%;" onclick="showStep('stepCognitive')">⬅️ Voltar</button>
    <button style="width:48%;" onclick="avancarPerguntaFinal()">➡️ Avançar</button>
  </div>
</div>

<!-- ========================================================= -->
<!-- 🔹 PERGUNTA FINAL -->
<!-- ========================================================= -->
<div id="stepFinalPergunta" class="hidden">
  <h2>🧠 Pergunta Final</h2>
  <p>O que você vai fazer mentalmente hoje durante o treino?</p>
  <select id="mentalChoicePre">
    <option>Respiração Controlada durante Intervalos</option>
    <option>Palavra de motivação</option>
    <option>Palavra de relaxamento</option>
    <option>Palavra para interromper pensamentos negativos</option>
    <option>Foco em palavras-chave (ex.: "força", "calma")</option>
    <option>Rotina de pré-ponto (respira, alvo, executa)</option>
    <option>Controle de erros (respiração curta + palavra positiva)</option>
    <option>Atenção seletiva (ex.: "olhar na bola")</option>
    <option>Auto-feedback (avaliar e seguir)</option>
  </select>

  <div style="display:flex;justify-content:space-between;margin-top:20px;">
    <button style="width:48%;" onclick="showStep('stepVisualizacao')">⬅️ Voltar</button>
    <button style="width:48%;" onclick="finalizarTreino('cognitivo')">💾 Finalizar Sessão</button>
  </div>
</div>

<!-- ========================================================= -->
<!-- 🔹 CONFIRMAÇÃO -->
<!-- ========================================================= -->
<div id="stepConfirmacao" class="hidden">
  <h2>✅ Dados salvos com sucesso!</h2>
  <button onclick="showStep('step1')">🔁 Novo Treino</button>
</div>

<!-- ========================================================= -->
<!-- 🔹 SCRIPTS FINAIS -->
<!-- ========================================================= -->
<script>
  function mostrarLegendaEspecifico() {
    const valor = document.getElementById("exEspecifico").value;
    const legenda = document.getElementById("legendaEspecifico");
    if (valor === "Tempo de Reação")
      legenda.innerText = "Exercício focado em resposta rápida a estímulos.";
    else if (valor === "Tempo de Reação / Força")
      legenda.innerText = "Exercício de reação associado a gestos de força.";
    else if (valor === "Tempo de Reação / Agilidade")
      legenda.innerText = "Exercício combinando reação e deslocamentos rápidos.";
    else legenda.innerText = "";
  }

  function mostrarBotaoJogo(){
    const valor=document.getElementById('exGeral').value;
    const botao=document.getElementById('botaoAbrirJogo');
    const jogos=["🎯 Jogo de Atenção","🎯 Jogo de Foco","🧩 Jogo de Memória","👁️‍🗨️ Jogo de Rastreamento Visual"];
    botao.style.display=jogos.includes(valor)?"block":"none";
  }

  function abrirJogoSelecionado(){
    const valor=document.getElementById('exGeral').value;
    if(valor==="🎯 Jogo de Atenção")window.open("jogo_atenção.html","_blank");
    else if(valor==="🎯 Jogo de Foco")window.open("jogo_foco.html","_blank");
    else if(valor==="🧩 Jogo de Memória")window.open("jogo_memoria.html","_blank");
    else if(valor==="👁️‍🗨️ Jogo de Rastreamento Visual")window.open("jogo_rastreamento.html","_blank");
  }

  function adicionarExercicio(tipo){
    const nome = tipo==="geral"?exGeral.value:exEspecifico.value;
    const tempo = tipo==="geral"?tempoGeral.value:tempoEspecifico.value;
    const nota = tipo==="geral"?notaGeral.value:notaEspecifico.value;
    if(!nome||!tempo||!nota)return alert("Preencha todos os campos.");
    state.exercicios.push({tipo,nome,tempo:parseInt(tempo),nota:parseInt(nota)});
    atualizarListaExercicios();

    if(tipo==="geral"){ exGeral.value=""; tempoGeral.value=""; notaGeral.value=""; mostrarBotaoJogo(); }
    else { exEspecifico.value=""; tempoEspecifico.value=""; notaEspecifico.value=""; }
  }

  function atualizarListaExercicios(){
    if(!window.listaExercicios){
      const div=document.createElement("div");
      div.id="listaExercicios";
      div.className="card";
      document.getElementById("stepCognitive").appendChild(div);
    }
    const lista=document.getElementById("listaExercicios");
    lista.innerHTML="<h3>🗒️ Exercícios:</h3>";
    if(state.exercicios.length===0){lista.innerHTML+="<p>Nenhum exercício.</p>";return;}
    lista.innerHTML+="<ul>"+state.exercicios.map(e=>`<li><b>${e.tipo}</b> — ${e.nome} | ${e.tempo} min | Nota: ${e.nota}</li>`).join("")+"</ul>";
  }

  function avancarVisualizacao(){
    if(state.exercicios.length===0)return alert("Adicione um exercício antes de prosseguir.");
    showStep("stepVisualizacao");
  }

  // Textos da visualização
  const visuals=[
    'Visualize a execução perfeita dos seus movimentos, com técnica e confiança.',
    'Imagine-se movimentando-se com leveza e agilidade em toda a quadra.',
    'Visualize jogando um game sacando, mantendo foco e controle.',
    'Visualize jogando um game recebendo, antecipando cada ação.',
    'Imagine-se em um ponto decisivo, respirando fundo e confiante.',
    'Visualize-se enfrentando um desafio com concentração e calma.',
    'Imagine reagindo rapidamente, mantendo o controle emocional.',
    'Visualize um momento de superação, mantendo-se focado e estável.'
  ];
  let visualIndex=0,visualTimerInterval=null;
  const beepAudio=new Audio("https://actions.google.com/sounds/v1/alarms/beep_short.ogg");

  function changeVisual(){
    let novo;
    do { novo = Math.floor(Math.random()*visuals.length); } while (novo === visualIndex);
    visualIndex = novo;
    visualText.innerText = visuals[visualIndex];
  }

  function startVisualizacao(){
    changeVisual();
    const tempo=parseInt(tempoVisualizacao.value);
    let tempoRestante=tempo*60;
    clearInterval(visualTimerInterval);
    visualTimerInterval=setInterval(()=>{
      const min=Math.floor(tempoRestante/60),sec=tempoRestante%60;
      visualTimer.innerText=`${String(min).padStart(2,"0")}:${String(sec).padStart(2,"0")}`;
      tempoRestante--;
      if(tempoRestante<0){
        clearInterval(visualTimerInterval);
        beepAudio.play();
        alert("⏰ Tempo finalizado!");
      }
    },1000);
  }

  function stopVisualizacao(){
    clearInterval(visualTimerInterval);
    visualTimer.innerText="";
  }

  function avancarPerguntaFinal(){
    showStep("stepFinalPergunta");
  }

  async function finalizarTreino(tipo){
    try{
      const hoje=new Date(),dataStr=hoje.toLocaleDateString("pt-BR");
      const doc={
        nome_atleta:state.athlete,
        data:dataStr,
        tipo_sessao:"pre",
        tipo_treino:tipo,
        vfc_rmssd:state.hrv,
        hooper_score:state.hooper,
        exercicios:state.exercicios,
        resposta_mental:mentalChoicePre.value,
        timestamp:firebase.firestore.FieldValue.serverTimestamp()
      };
      await db.collection("cognitivo").add(doc);
      state.exercicios=[];
      showStep("stepConfirmacao");
    }catch(e){
      alert("Erro ao salvar.");
      console.error(e);
    }
  }
</script>

</div> <!-- fecha container -->
</body>
</html>
